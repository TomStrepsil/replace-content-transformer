{
  "name": "benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Benchmark tooling and harnesses for replace-content-transformer",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebench": "npm run build --silent",
    "bench": "node build/test/benchmarks/runtime/benchmarks.js",
    "prebench:bun": "npm run build --silent",
    "bench:bun": "bun run build/test/benchmarks/runtime/benchmarks.js",
    "prebench:deno": "npm run build --silent",
    "bench:deno": "deno run --allow-read --allow-write --allow-env --allow-sys build/test/benchmarks/runtime/benchmarks.js",
    "prebench:node": "npm run build --silent",
    "bench:node": "node build/test/benchmarks/runtime/benchmarks.js",
    "bench:runtimes": "./runtime/bench-all.sh",
    "prebench:compare-runtimes": "npm run build --silent",
    "bench:compare-runtimes": "node --import tsx runtime/compare.ts",
    "prebench:algorithms": "npm run build --silent",
    "bench:algorithms": "node build/test/benchmarks/algorithm/comparison.bench.js",
    "bench:algorithms:json": "./algorithm/run.sh",
    "bench:algorithms:json:succinct": "./algorithm/run-succinct.sh",
    "bench:algorithms:visualise": "node --import tsx algorithm/visualise-results.ts",
    "prebench:regex-shapes": "npm run build --silent",
    "bench:regex-shapes": "node build/test/benchmarks/regex-shapes/run.bench.js",
    "bench:regex-shapes:report": "node --import tsx regex-shapes/report.ts",
    "prebench:regex-shapes:json": "npm run build --silent",
    "bench:regex-shapes:json": "node build/test/benchmarks/regex-shapes/run.bench.js --json",
    "bench:lookahead-engine": "./lookahead-engine/run.sh",
    "bench:lookahead-engine:timeline": "./lookahead-engine/run.sh --timeline",
    "bench:lookahead-engine:scenario": "./lookahead-engine/run.sh --scenario"
  },
  "devDependencies": {
    "mitata": "^1.0.10",
    "tsx": "^4.21.0"
  }
}
